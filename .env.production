# Producción — VPS 76.13.161.228 — SPA bajo /ripser
# =========================================================
# VITE_API_BASE_URL=/ripser: los clientes que llaman '/api/...' quedan en
#   /ripser/api/... (api/config.ts, useFinancialEvents, testConnection).
# Nginx hace proxy de /ripser/api/* → http://76.13.161.228:8080/RipserApp/api/*
# (el proxy_pass al backend NO cambió con el cutover).
# =========================================================

VITE_API_BASE_URL=/ripser
VITE_API_URL=/ripser/api
VITE_API_TIMEOUT=10000

# Host+prefijo para los QR impresos (ficha pública de equipos).
# Los QRs viejos apuntan a /public/equipos/... y nginx los 301-redirige a
# /ripser/public/equipos/... (excepción PERMANENTE, ver DEPLOY_VPS.md).
VITE_QR_BASE_URL=https://www.ysysoftware.com/ripser

# Sentry — frontend (ripser-front)
VITE_SENTRY_DSN=https://f01bb64c08dec893dbd8f9736a154b3e@o4511322212728832.ingest.de.sentry.io/4511322217185360
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
